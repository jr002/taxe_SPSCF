{
  "name": "ssif",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "setup:project": "pnpm install --frozen-lockfile && pnpm run prisma:deploy",
    "prisma:deploy": "pnpm --filter backend run prisma:deploy",
    "dev": "pnpm --parallel --filter backend --filter frontend run dev",
    "build": "pnpm --filter frontend run build"
  }
}
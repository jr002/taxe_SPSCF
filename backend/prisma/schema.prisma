generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model agents {
  id_agent          Int         @id @default(autoincrement())
  nom               String      @db.VarChar(100)
  prenom            String      @db.VarChar(100)
  email             String      @unique @db.VarChar(255)
  mot_de_passe      String      @db.VarChar(255)
  role              String?     @default("agent") @db.VarChar(50)
  statut            String?     @default("actif") @db.VarChar(20)
  date_creation     DateTime?   @default(now()) @db.Timestamp(6)
  date_modification DateTime?   @db.Timestamp(6)
  controles         controles[]

  @@index([email], map: "idx_agents_email")
}

model controles {
  id_controle       Int           @id @default(autoincrement())
  id_declaration    Int?
  id_agent          Int?
  type              String        @db.VarChar(20)
  resultat          String        @db.VarChar(20)
  ecart             Decimal?      @default(0) @db.Decimal(15, 2)
  pourcentage_ecart Decimal?      @default(0) @db.Decimal(8, 2)
  commentaire       String?
  date_controle     DateTime?     @default(now()) @db.Timestamp(6)
  agents            agents?       @relation(fields: [id_agent], references: [id_agent], onUpdate: NoAction)
  declarations      declarations? @relation(fields: [id_declaration], references: [id_declaration], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_declaration], map: "idx_controles_declaration")
}

model declarations {
  id_declaration    Int            @id @default(autoincrement())
  id_contribuable   Int?
  annee             Int
  ca                Decimal?       @default(0) @db.Decimal(15, 2)
  benefice          Decimal?       @default(0) @db.Decimal(15, 2)
  tva_collectee     Decimal?       @default(0) @db.Decimal(15, 2)
  tva_deductible    Decimal?       @default(0) @db.Decimal(15, 2)
  tva_payee         Decimal?       @default(0) @db.Decimal(15, 2)
  tva_theorique     Decimal?       @default(0) @db.Decimal(15, 2)
  statut            String?        @default("conforme") @db.VarChar(20)
  date_creation     DateTime?      @default(now()) @db.Timestamp(6)
  date_modification DateTime?      @db.Timestamp(6)
  controles         controles[]
  contribuables     contribuables? @relation(fields: [id_contribuable], references: [id_contribuable], onDelete: Cascade, onUpdate: NoAction, map: "declarations_id_entreprise_fkey")

  @@unique([id_contribuable, annee], map: "declarations_id_entreprise_annee_key")
  @@index([annee], map: "idx_declarations_annee")
  @@index([id_contribuable], map: "idx_declarations_entreprise")
  @@index([statut], map: "idx_declarations_statut")
}

model recoupements {
  id_recoupement       Int            @id @default(autoincrement())
  id_contribuable      Int?
  source               String         @db.VarChar(50)
  merchandise_sold     Decimal?       @default(0) @db.Decimal(15, 2)
  goods_purchased      Decimal?       @default(0) @db.Decimal(15, 2)
  services_purchased   Decimal?       @default(0) @db.Decimal(15, 2)
  third_party_payments Decimal?       @default(0) @db.Decimal(15, 2)
  local_products       Decimal?       @default(0) @db.Decimal(15, 2)
  import_expenses      Decimal?       @default(0) @db.Decimal(15, 2)
  somme_recoupee       Decimal?       @default(0) @db.Decimal(15, 2)
  date_creation        DateTime?      @default(now()) @db.Timestamp(6)
  contribuables        contribuables? @relation(fields: [id_contribuable], references: [id_contribuable], onDelete: Cascade, onUpdate: NoAction, map: "recoupements_id_entreprise_fkey")

  @@index([id_contribuable], map: "idx_recoupements_entreprise")
}

model contribuables {
  id_contribuable   Int            @id(map: "entreprises_pkey") @default(autoincrement())
  nif               String         @unique(map: "entreprises_nif_key") @db.VarChar(50)
  raison_sociale    String         @db.VarChar(255)
  secteur_activite  String         @db.VarChar(100)
  adresse           String?
  telephone         String?        @db.VarChar(20)
  email             String?        @db.VarChar(100)
  regime_fiscal     String?        @db.VarChar(10)
  date_creation     DateTime?      @default(now()) @db.Timestamp(6)
  date_modification DateTime?      @db.Timestamp(6)
  declarations      declarations[]
  recoupements      recoupements[]

  @@index([nif], map: "idx_entreprises_nif")
}
